// QUESTION 2 -----------------

#include <iostream>
using namespace std;

int main() {
    int n;
    
    cin >> n;

    int arr[n];

    for (int i = 0; i < n; i++) {
        cin >> arr[i];
    }

    int count = 0;

    // Checking all pairs
    for (int i = 0; i < n; i++) {

        for (int j = i + 1; j < n; j++) {

            if ((arr[i] + arr[j]) % 2 == 0) {
                count++;
         }
      }
    }

    cout << count;

    return 0;
}
