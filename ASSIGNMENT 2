#include <iostream>
using namespace std;

int main() {
    int n;
    int count = 0;

    cin >> n;

    while (n > 0) {

        if (n % 2 == 1) {
            count++;
        }

        n = n / 2;
    }

    if (count % 2 == 0) {
        cout << "Even";
    }
    else {
        cout << "Odd";
    }

    return 0;
}


